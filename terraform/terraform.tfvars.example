# CloudSentry Configuration
# Copy this file to terraform.tfvars and fill in your values

# ─────────────────────────────────────────────────────────────────
# NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────
# All emails receive the weekly HTML report. Each must confirm the
# SNS subscription (check inbox after first deploy).
notification_emails = [
  "you@example.com",
  "team@example.com",
]

# Optional: Slack webhook for short summary notifications
slack_webhook_url = ""

# ─────────────────────────────────────────────────────────────────
# DASHBOARD (Custom Domain)
# ─────────────────────────────────────────────────────────────────
# To use a custom domain (e.g., cloudsentry.yourdomain.com):
#
# Step 1: Deploy first with these empty to create CloudFront
# Step 2: Request ACM cert:
#   aws acm request-certificate \
#     --domain-name cloudsentry.yourdomain.com \
#     --validation-method DNS \
#     --region us-east-1
#
# Step 3: Get the validation CNAME:
#   aws acm describe-certificate \
#     --certificate-arn <ARN_FROM_STEP_2> \
#     --region us-east-1 \
#     --query 'Certificate.DomainValidationOptions[0].ResourceRecord'
#
# Step 4: Add the validation CNAME to your DNS (Cloudflare, Route53, etc.)
#   Type: CNAME, Name: _xxx.cloudsentry, Value: _yyy.acm-validations.aws.
#   Proxy: OFF (DNS only)
#
# Step 5: Wait for cert to validate (usually 1-5 minutes):
#   aws acm describe-certificate --certificate-arn <ARN> --query 'Certificate.Status'
#
# Step 6: Add these values and run terraform apply:
dashboard_domain       = ""
dashboard_acm_cert_arn = ""
#
# Step 7: Add CNAME pointing your subdomain to CloudFront:
#   Type: CNAME, Name: cloudsentry, Value: <cloudfront-domain from terraform output>
#   Proxy: OFF (DNS only)
#
# Your dashboard is now live at https://cloudsentry.yourdomain.com

# ─────────────────────────────────────────────────────────────────
# AWS REGION
# ─────────────────────────────────────────────────────────────────
aws_region = "us-east-1"

# Schedule: when to run the weekly scan (default: Monday 7am UTC)
# schedule_expression = "cron(0 7 ? * MON *)"

# ─────────────────────────────────────────────────────────────────
# ACCOUNTS
# ─────────────────────────────────────────────────────────────────
# Leave empty to scan only the local account (single-account mode).
# Add entries to scan multiple accounts (multi-account mode).
#
# For each target account, deploy the cross-account role first:
#   cd cross-account-role/
#   terraform apply -var="hub_account_id=YOUR_HUB_ACCOUNT_ID"

accounts = []

# Multi-account example:
# accounts = [
#   {
#     name       = "Production"
#     account_id = "111111111111"
#     role_arn   = "arn:aws:iam::111111111111:role/CloudSentryAuditRole"
#   },
#   {
#     name       = "Staging"
#     account_id = "222222222222"
#     role_arn   = "arn:aws:iam::222222222222:role/CloudSentryAuditRole"
#   },
# ]

# ─────────────────────────────────────────────────────────────────
# TAG POLICY
# ─────────────────────────────────────────────────────────────────
required_tags      = ["Environment", "Project", "Owner", "CostCenter", "ManagedBy"]
environment_values = ["production", "staging", "development", "sandbox"]
managed_by_values  = ["terraform", "cloudformation", "manual", "cdk", "pulumi"]

# ─────────────────────────────────────────────────────────────────
# APPROVED INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────
approved_regions        = ["us-east-1", "eu-west-1"]
approved_instance_types = ["t3.micro", "t3.small", "t3.medium", "t3.large"]

# ─────────────────────────────────────────────────────────────────
# COST POLICY
# ─────────────────────────────────────────────────────────────────
cost_alert_threshold = 50

# Services excluded from per-resource cost alerts (tracked via budget caps)
excluded_services_from_cost_alert = ["AmazonBedrock", "AmazonSageMaker"]

# Budget caps for approved expensive services
budget_caps = [
  {
    service     = "AmazonBedrock"
    max_monthly = 200
    reason      = "AI development"
  },
]

# ─────────────────────────────────────────────────────────────────
# LIFECYCLE POLICY
# ─────────────────────────────────────────────────────────────────
max_snapshot_age_days   = 90
max_sandbox_age_days    = 7
max_access_key_age_days = 90

# ─────────────────────────────────────────────────────────────────
# LAMBDA SETTINGS
# ─────────────────────────────────────────────────────────────────
# lambda_timeout = 300  # seconds (increase for many accounts/regions)
# lambda_memory  = 256  # MB
